{
  "version": 8,
  "description": "smoothing_window=5 — production has high month-to-month noise (2014: 272,594,378,746,796,1075,201 bbl), wider smoothing should give cleaner trend for fitting",
  "preprocessing": {
    "significance_threshold": 0.30,
    "smoothing_window": 5,
    "outlier_window": 3,
    "outlier_threshold": 0.15,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.05,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "conventional"
}