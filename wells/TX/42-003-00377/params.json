  "fitting": {
    "d_min": 0.03,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "conventional"
