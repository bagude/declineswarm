{
  "version": 7,
  "description": "outlier_window=5 \u2014 wider outlier detection window to better identify shut-in months (0 bbl) and partial months (3-15 bbl) surrounded by normal production",
  "preprocessing": {
    "significance_threshold": 0.5,
    "smoothing_window": 5,
    "outlier_window": 5,
    "outlier_threshold": 0.3,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.03,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "shale"
}