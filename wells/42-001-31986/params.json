{
  "version": 10,
  "description": "significance_threshold=0.75 — filter out more insignificant production phases (low-volume restarts in 2016-17, 2019 spikes). Focus model on the primary decline trend from 1993-2015.",
  "preprocessing": {
    "significance_threshold": 0.75,
    "smoothing_window": 3,
    "outlier_window": 3,
    "outlier_threshold": 0.15,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.10,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "conventional"
}