    "significance_threshold": 0.5,
    "smoothing_window": 5,
    "outlier_window": 3,
    "outlier_threshold": 0.3,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.03,
    "di_initial": 0.30,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "conventional"
}
