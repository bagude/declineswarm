{
  "version": 3,
  "description": "d_min 0.05->0.03 — v2 showed higher d_min worsens fit. Flat 2018-2025 oil (300-700 bbl/mo, ~7yr no decline) needs lower d_min to allow near-zero terminal decline rate",
  "preprocessing": {
    "significance_threshold": 0.5,
    "smoothing_window": 3,
    "outlier_window": 3,
    "outlier_threshold": 0.3,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.03,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "shale"
}
