{
  "version": 10,
  "description": "smoothing_window=5 \u2014 dampen 2020 curtailment noise and monthly volatility, this well has significant scatter (e.g., Jan 2020 dip to 281, then recovery to 461)",
  "preprocessing": {
    "significance_threshold": 0.5,
    "smoothing_window": 5,
    "outlier_window": 3,
    "outlier_threshold": 0.3,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.08,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "shale"
}
