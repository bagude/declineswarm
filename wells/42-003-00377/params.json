{
  "version": 6,
  "description": "outlier_window=5 \u2014 well has sharp dips (1994-11: 180, 2001-12: 1, 2013-12: 78, 2022-04: 8) that need wider context window to flag as outliers",
  "preprocessing": {
    "significance_threshold": 0.5,
    "smoothing_window": 3,
    "outlier_window": 5,
    "outlier_threshold": 0.3,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.03,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "conventional"
}