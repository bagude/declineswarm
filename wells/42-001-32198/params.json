{
  "version": 4,
  "description": "significance_threshold=0.40 — lower threshold keeps more phases separate; well has distinct 1995-1998, 2010-2019, 2020+ phases that need isolation",
  "preprocessing": {
    "significance_threshold": 0.40,
    "smoothing_window": 3,
    "outlier_window": 3,
    "outlier_threshold": 0.15,
    "peak_merge_distance": 3,
    "min_clean_months": 3
  },
  "fitting": {
    "d_min": 0.05,
    "di_initial": 0.5,
    "b_initial": 0.5,
    "qi_guess_strategy": "first",
    "qi_multiplier_upper": 5.0,
    "di_upper_bound": 5.0,
    "b_upper_bound": 2.0
  },
  "well_type": "conventional"
}